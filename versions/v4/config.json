{
    "name": "small_end_to_end",
    "agent_dir": "",
    "architecture": {
        "d_model": 64,
        "n_heads": 8,
        "n_kv_heads": 2,
        "d_ff": 256,
        "n_encoder_layers": 6,
        "n_decoder_layers": 4,
        "n_value_layers": 4,
        "n_action_layers": 6,
        "n_opponent_action_layers": 6,
        "n_modelling_layers": 4,
        "max_seq_len": 2048,
        "max_players": 9,
        "memory": {
            "n_levels": 2,
            "max_cluster_size": 128,
            "max_cluster_size_after": 64,
            "beam_width": 8
        },
        "opponent_embedding": {
            "enabled": true
        }
    },
    "multi_agent": {
        "save_dir": "2_final_agents",
        "agents": [
            {
                "name": "gto_pure",
                "modifiers": [
                    {"type": "temperature", "value": 0.5}
                ]
            },
            {
                "name": "lag_bluffer",
                "modifiers": [
                    {"type": "action_bias", "actions": "aggressive", "factor": 0.35},
                    {"type": "action_bias", "actions": "fold", "factor": -0.25},
                    {"type": "conditional_bias", "condition": "equity < 0.3", "actions": "raises", "factor": 0.4},
                    {"type": "temperature", "value": 0.3}
                ]
            }
        ]
    },
    "game": {
        "raise_sizes": {
            "preflop": [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 6.0],
            "flop":    [0.1, 0.25, 0.33, 0.4, 0.5, 0.67, 0.75, 1.0, 1.25, 1.5, 2.0],
            "turn":    [0.1, 0.25, 0.33, 0.4, 0.5, 0.67, 0.75, 1.0, 1.25, 1.5, 2.0],
            "river":   [0.1, 0.25, 0.33, 0.4, 0.5, 0.67, 0.75, 1.0, 1.25, 1.5, 2.0]
        },
        "max_players": 9,
        "max_stack": 3000,
        "big_blind": 10
    },
    "solver": {
        "type": "v3",
        "mc_iterations": 1000,
        "n_raise_samples": 3,
        "gto_temperature": 0.2,
        "eqr_enabled": true,
        "combo_response_iters": 30,
        "reraise_threshold": 0.72,
        "weighted_sampling": true,
        "marginal_mc_iters": 0,
        "marginal_response_iters": 0
    },
    "dataset": {
        "dataset_dir": "",
        "save_dir": "",
        "n_scenarios": 1000,
        "val_split": 0.05,
        "n_workers": 8,
        "save_every_hands": 1000
    },
    "gto_ev_train": {
        "lr": 1e-4,
        "batch_size": 64,
        "epochs": 5,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 3e-6
    },
    "gto_probs_train": {
        "lr": 1e-4,
        "batch_size": 64,
        "epochs": 5,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 3e-6
    },
    "modelling_train": {
        "lr": 1e-4,
        "batch_size": 64,
        "epochs": 2,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 3e-6,
        "recon_weight": 0.8
    },
    "gto_train": {
        "lr": 5e-5,
        "batch_size": 64,
        "epochs": 2,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 1e-6,
        "action_loss_weight": 1.2
    },
    "opponent_data": {
        "agents_dir": "2_final_agents",
        "n_hands": 500,
        "action_temperature": 0.3,
        "range_threshold": 0.75,
        "max_batch_combos": 128,
        "save_dir": "",
        "save_every_hands": 1000,
        "player_swap_prob": 0.02,
        "n_player_pool": 27
    },
    "opponent_action_train": {
        "lr": 1e-4,
        "batch_size": 64,
        "epochs": 2,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 3e-6,
        "val_split": 0.05
    },
    "mcts": {
        "n_simulations": 1000,
        "c_puct": 1.5,
        "dirichlet_alpha": 0.3,
        "dirichlet_epsilon": 0.25,
        "temperature": 1.0,
        "n_equity_iters": 3000
    },
    "mcts_train": {
        "n_cycles": 10,
        "n_hands_per_cycle": 500,
        "examples_dir": "",
        "lr": 3e-5,
        "batch_size": 16,
        "epochs": 2,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 1e-6,
        "val_split": 0.1,
        "value_weight": 1.0,
        "action_weight": 1.0,
        "chain_weight": 2.5
    },
    "evaluation": {
        "agents_dir": "2_final_agents",
        "num_players": 5,
        "n_hands": 100000,
        "big_blind": 10,
        "start_stack": 1000,
        "min_rebuy_stack": 500,
        "max_rebuy_stack": 1500,
        "max_stack_cap": 3000,
        "log_every": 1000,
        "action_temperature": 0.3,
        "n_tables": 16,
        "use_opponent_emb": true
    },
    "pipeline": {
        "run_gto_ev": false,
        "run_gto_probs": false,
        "run_gto_training": true,
        "run_modelling": true,
        "run_opponent_data": true,
        "run_opponent_action_train": true,
        "run_mcts_train": true,
        "run_evaluation": true
    }
}
