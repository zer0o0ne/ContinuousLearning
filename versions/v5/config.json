        "scheduler_eta_min": 1e-6,
        "estimated_steps_per_cycle": 20,
        "val_split": 0.1,
        "value_weight": 1.0,
        "action_weight": 1.0,
        "chain_weight": 1.0,
        "max_chain_depth": 4,
        "chain_depth_gamma": 0.75,
        "recon_weight": 0.5,
        "value_chain_weight": 0.0,
