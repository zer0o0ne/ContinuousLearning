    "gto_ev_train": {
        "lr": 1e-4,
        "batch_size": 64,
        "epochs": 5,
        "max_grad_norm": 1.0,
        "log_every": 10,
        "val_every": 50,
        "interrupt_after_fails": 100,
        "scheduler_eta_min": 3e-6
    },
    "gto_probs_train": {
        "lr": 1e-4,
        "batch_size": 64,
