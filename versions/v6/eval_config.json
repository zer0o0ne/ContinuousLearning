    "mcts": {
        "n_simulations": 512,
        "c_puct": 1.5,
        "dirichlet_alpha": 0.3,
        "dirichlet_epsilon": 0.0,
        "dirichlet_alpha_inner": 0.3,
        "dirichlet_epsilon_inner": 0.0,
        "temperature": 0.1,
        "batch_size": 64,
        "virtual_loss": 0.5,
        "opp_prior_smoothing": 0.15,
        "opp_pessimism_alpha": 0.5
    },

    "solver": {
        "type": "v4",
        "mc_iterations": 25000,
        "n_raise_samples": 5,
        "gto_temperature": 0.2,
        "eqr_enabled": true,
        "combo_response_iters": 200,
        "reraise_threshold": 0.72,
        "weighted_sampling": true,
        "marginal_mc_iters": 0,
        "marginal_response_iters": 0,
        "threshold_smoothing": {
            "enabled": true,
            "beta_fold": 0.07,
            "beta_reraise": 0.07
        },
        "polarized_reraise": {
            "enabled": true,
            "bluff_threshold": 0.25,
            "beta_bluff": 0.10,
            "bluff_frequency": 0.30
        }
    },

    "internal_evaluation": {
        "enabled": false,
        "n_hands": 100000,
